# ============================================================
# VIRS - 环境变量配置模板
#
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env
#   2. 修改其中各项的值，特别是标记 [必填] 的项
#   3. 生产环境中所有密钥必须替换为随机字符串
#
# 分类说明：
#   [必填-密钥]     — 缺失或使用默认值将拒绝启动（P0 安全）
#   [必填-连接]     — 缺失将拒绝启动
#   [可选-基础设施] — 有安全默认值
#   [可选-运行调参] — 有安全默认值，按业务域分组
#   [仅 Docker]     — Rust 代码不读取，仅 docker-compose.yml 消费
#   [仅代码]        — 不经 AppConfig，由特定模块直接读取
# ============================================================

# ============================================================
# [必填-密钥] 生产环境必须替换为随机字符串
# ============================================================
# ENCRYPTION_KEY 与 LLM_KEY 必须不同！
#   ENCRYPTION_KEY：加密交易所 API 凭证
#   LLM_KEY：加密 AI/LLM API 凭证
#   JWT_SECRET：签发 JWT 令牌，至少 32 字符
# 生成随机密钥：openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-64-char-string-in-production
LLM_KEY=change-me-to-a-random-64-char-string-in-production
JWT_SECRET=change-me-to-a-random-32-char-or-longer-string-in-production
# JWT 令牌有效期（小时），默认 24
JWT_EXPIRATION_HOURS=24

# ============================================================
# [必填-连接] 数据库与管理员账户
# ============================================================
# ---- 数据库（PostgreSQL）----
# 本地开发用 localhost，Docker 部署用 postgres
DATABASE_URL=postgresql://virs:virs123@localhost:5432/virs
# ---- 管理员账户 [必填] 首次启动时创建，无默认值 ----
# ADMIN_PASSWORD 至少 12 字符
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password-at-least-12-chars

# ============================================================
# [可选-基础设施] 服务器 / 数据库连接池 / 代理
# ============================================================
HOST=0.0.0.0
PORT=8080
# 连接池大小
DB_POOL_MIN=5
DB_POOL_MAX=50
# 连接获取超时（秒）— 从池中获取连接的等待时间，默认 10
# DB_ACQUIRE_TIMEOUT_SECS=10
# 代理（选填，用于访问交易所 API）
# PROXY_URL=socks5://127.0.0.1:1080

# ============================================================
# [可选-运行调参] 超时/时间配置（单位：秒）
# ============================================================
# 控制系统中各类超时和轮询间隔，不设置时使用代码中的默认值
# TIME_MAX_POSITION_DURATION_SECS=172800   # 最大持仓时长，超时强制平仓（默认 48 小时）
# TIME_PENDING_ORDER_TIMEOUT_SECS=60       # 挂单超时，超时取消（默认 60 秒）
# TIME_PRICE_POLL_INTERVAL_SECS=5          # auto worker 价格轮询间隔（默认 5 秒）
# TIME_CLOSE_ORDER_TIMEOUT_SECS=15         # 平仓订单等待超时，等待 PE 仓位事件恢复（默认 15 秒）
# TIME_HTTP_TIMEOUT_SECS=30               # 交易所 REST API HTTP 请求超时（默认 30 秒）
# TIME_LLM_TIMEOUT_SECS=120               # LLM API 请求超时（默认 120 秒）

# ---- 重试配置 ----
# INITIAL_PRICE_MAX_RETRIES=10            # Worker 启动时获取初始价格的最大重试次数（默认 10）
# PERSIST_MAX_RETRIES=3                   # persist! 宏 DB 持久化最大重试次数（默认 3）
# PERSIST_RETRY_BASE_MS=100               # persist! 宏重试退避基数毫秒，间隔=base×attempt（默认 100）

# ---- HTTP 客户端 ----
# HTTP_CONNECT_TIMEOUT_SECS=10            # TCP 连接建立超时（默认 10 秒，与 TIME_HTTP_TIMEOUT_SECS 不同）
# HTTP_POOL_MAX_IDLE_PER_HOST=10          # 每主机最大空闲连接数（默认 10）

# ---- 币安 listenKey 保活 ----
# LISTENKEY_KEEPALIVE_FUTURES_SECS=1800  # 合约 listenKey 保活间隔（默认 1800=30min）

# ============================================================
# [仅 Docker] docker-compose.yml 消费，Rust 代码不读取
# ============================================================
POSTGRES_USER=virs
POSTGRES_PASSWORD=virs123
POSTGRES_DB=virs
# POSTGRES_PORT=5432    # PostgreSQL 宿主机映射端口
# BACKEND_PORT=8080     # 后端服务宿主机映射端口

# ============================================================
# [仅代码] 不经 AppConfig，由特定模块直接 env::var 读取
# ============================================================
# 日志级别（格式：crate名=级别，多个用逗号分隔）
# binance_api=info 可启用币安 REST API 调用日志（完整 URL + 响应）
# 调试时改为 debug，生产环境建议保持 info
RUST_LOG=virs_app=info,virs_bot=info,virs_position=info,virs_market=info,virs_api=info,binance_api=info
# 前端静态文件目录（router.rs 读取，默认 ./frontend/dist）
# Docker 部署时由 docker-compose.yml 硬编码为 /app/frontend/dist
# FRONTEND_DIR=./frontend/dist
