# ============================================================
# VIRS - Environment Configuration
# Copy this file to .env and modify as needed
# ============================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
RUST_LOG=virs=info,tower_http=debug

# ---- Security (REQUIRED — must change in production) ----
# SECRET_KEY and ENCRYPTION_KEY must be different!
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ENCRYPTION_KEY=change-me-to-another-random-64-char-string-must-differ-from-secret-key
JWT_EXPIRATION_HOURS=24

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://virs:virs123@localhost:5432/virs
POSTGRES_USER=virs
POSTGRES_PASSWORD=virs123
POSTGRES_DB=virs
DB_POOL_MIN=5
DB_POOL_MAX=50

# ---- Admin Account (created on first startup) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Trading Mode ----
# true = paper trading (simulated), false = real exchange
PAPER_TRADING=true

# ---- AI / LLM (at least one required for AI features) ----
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ---- Notification: Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Notification: Email SMTP (optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@virs.com

# ---- Proxy (optional, for exchange API access) ----
# PROXY_URL=socks5://127.0.0.1:1080

# ---- Data Cache TTL (seconds) ----
CACHE_TTL_TICKER=10
CACHE_TTL_KLINE_1M=60
CACHE_TTL_KLINE_5M=120
CACHE_TTL_KLINE_1H=300
CACHE_TTL_KLINE_1D=3600
