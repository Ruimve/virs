# ============================================================
# VIRS - Environment Configuration
# Copy this file to .env and modify as needed
# ============================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8080
RUST_LOG=virs=info,tower_http=debug

# ---- Security (REQUIRED — must change in production) ----
# ENCRYPTION_KEY and LLM_KEY must be different!
# ENCRYPTION_KEY: encrypts exchange API credentials
# LLM_KEY: encrypts AI/LLM API credentials
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-random-64-char-string-in-production
LLM_KEY=change-me-to-a-random-64-char-string-in-production
JWT_SECRET=change-me-to-a-random-32-char-or-longer-string-in-production
JWT_EXPIRATION_HOURS=24

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://virs:virs123@localhost:5432/virs
POSTGRES_USER=virs
POSTGRES_PASSWORD=virs123
POSTGRES_DB=virs
DB_POOL_MIN=5
DB_POOL_MAX=50

# ---- Admin Account (created on first startup) ----
# REQUIRED — no defaults, must be set explicitly.
# ADMIN_PASSWORD must be at least 12 characters for security.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password-at-least-12-chars

# ---- Proxy (optional, for exchange API access) ----
# PROXY_URL=socks5://127.0.0.1:1080

# ---- Time / Timeout Configuration (optional — all have safe defaults) ----
# These control critical timeout and interval behavior across the system.
# All values are in seconds.
# TIME_MAX_POSITION_DURATION_SECS=172800   # max position hold time (48h)
# TIME_PENDING_ORDER_TIMEOUT_SECS=60       # pending order timeout
# TIME_PRICE_POLL_INTERVAL_SECS=5          # auto worker price poll interval
# TIME_CLOSE_ORDER_TIMEOUT_SECS=15         # close order REST call timeout (PositionEngine)
# TIME_HTTP_TIMEOUT_SECS=30                # exchange REST API HTTP timeout (ExchangeClient)
# TIME_LLM_TIMEOUT_SECS=120                # LLM API request timeout (AiClient)
