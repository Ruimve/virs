# ============================================================
# VIRS - Environment Configuration
# Copy this file to .env and modify as needed
# ============================================================

# ---- Server ----
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
RUST_LOG=virs=info,tower_http=debug

# ---- Security ----
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ENCRYPTION_KEY=change-me-to-another-random-64-char-string-must-differ-from-secret-key
JWT_EXPIRATION_HOURS=24

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://virs:virs123@postgres:5432/virs
DB_POOL_MIN=5
DB_POOL_MAX=50

# ---- Redis (Optional) ----
REDIS_URL=redis://redis:6379/0
# REDIS_PASSWORD=

# ---- Admin Account (created on first startup) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- AI / LLM ----
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---- Notification: Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Notification: Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@virs.com

# ---- Proxy (Optional) ----
# PROXY_URL=socks5://127.0.0.1:1080

# ---- Strategy Runtime ----
STRATEGY_EXECUTOR_WORKERS=4
PENDING_ORDER_WORKER_ENABLED=true
PENDING_ORDER_POLL_INTERVAL_SECS=5
AUTO_RESTORE_STRATEGIES=true

# ---- Data Cache TTL (seconds) ----
CACHE_TTL_TICKER=10
CACHE_TTL_KLINE_1M=60
CACHE_TTL_KLINE_5M=120
CACHE_TTL_KLINE_1H=300
CACHE_TTL_KLINE_1D=3600
